{
  "spec": "motion-gauge/predicates/1",
  "kind": "seek",
  "frame": "#frame",
  "timeline": "animations",
  "viewport": [1920, 1080],
  "beats": [
    {"label": "order arrives", "at": 1.0, "window": [0, 1.0],
     "learns": "an order has come in",
     "predicates": ["appearsBy(#card-a, 0.5)", "staysInFrame(#title)", "maxMovers(2)", "density(max_cell=0.6)"]},
    {"label": "token rides", "at": 1.6, "window": [1.0, 1.6],
     "learns": "the order travels on",
     "predicates": ["appearsBy(#token, 0.1)", "staysInFrame(#token)", "maxMovers(1)"]},
    {"label": "shipped", "at": 2.6, "window": [1.6, 2.6],
     "learns": "the order has shipped and been checked",
     "predicates": ["before(#card-b, #lbl)", "noOverlap(#card-a, #card-b)", "appearsBy(#lbl, 1)"]}
  ]
}
